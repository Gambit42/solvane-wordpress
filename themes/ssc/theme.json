{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#0E0E0E"
				},
				{
					"slug": "slate",
					"name": "Slate",
					"color": "#6B6B6B"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#E7E4DF"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#FFFFFF"
				},
				{
					"slug": "sand",
					"name": "Sand",
					"color": "#F6F4F1"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "sun",
					"name": "Sun",
					"color": "#D9A05B"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "figtree",
					"name": "Figtree",
					"fontFamily": "Figtree, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Figtree-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.1875rem",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.625rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.625rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "4.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "11rem",
					"fluid": {
						"min": "3.75rem",
						"max": "11rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1.25rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(3rem, 6vw, 4.5rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(3.5rem, 8vw, 6rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--figtree)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--slate)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "500",
					"lineHeight": "1.08",
					"letterSpacing": "-0.035em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1",
					"letterSpacing": "-0.045em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem",
					"fontWeight": "500",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.3"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.4rem",
						"right": "1.4rem"
					}
				},
				"typography": {
					"fontWeight": "500",
					"fontSize": "0.9375rem",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "#2A2A2A",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--sun)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "0.9375rem",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "500"
				}
			},
			"core/image": {
				"border": {
					"radius": "20px"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "20px"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
